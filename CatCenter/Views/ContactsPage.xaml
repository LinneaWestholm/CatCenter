<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatCenter.Views.ContactsPage"
             Title="ContactsPage"
             BackgroundImageSource="catlogo.png" HeightRequest="800" WidthRequest="800">

    <VerticalStackLayout>
        <ScrollView>
            <Grid RowDefinitions="Auto, Auto, Auto" Padding="0,20,0,20">

                <Label Text="Här kan du kontakta oss:"  
                   HorizontalOptions="Center"  
                   VerticalOptions="Center"  
                   Style="{StaticResource Headline}"  
                   Grid.Row="0"></Label>

                <Label Text="catadoptioncenter@outlook.com"  
                   HorizontalOptions="Center"  
                   VerticalOptions="Center"  
                   FontSize="15"  
                   Margin="15"
                   Grid.Row="1"></Label>

            </Grid>
        </ScrollView>
    </VerticalStackLayout>

</ContentPage>