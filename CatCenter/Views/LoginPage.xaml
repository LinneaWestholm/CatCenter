<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatCenter.Views.LoginPage"
             Title="LoginPage"
             BackgroundColor="LavenderBlush">
    
    <VerticalStackLayout Padding="40" Spacing="10">

        <Label Text="Logga in" TextColor="Purple"  FontSize="25"></Label>

        <Entry x:Name="UsernameEntry"
               Placeholder="Username"
               BackgroundColor="White"></Entry>

        <Entry x:Name="PasswordEntry"
               Placeholder="Password"
               BackgroundColor="White"
               IsPassword="true"></Entry>

        <Button Text="Logga in"
                BackgroundColor="MediumPurple"
                Clicked="OnClickedLoggedIn"/>


        <Label Text="Inget konto? Registrera dig här!" TextColor="Purple" FontSize="15" HorizontalOptions="Center"/>


    </VerticalStackLayout>
</ContentPage>