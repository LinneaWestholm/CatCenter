<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatCenter.Views.OurCatsPage"
             Title="OurCatsPage"
             BackgroundColor="LavenderBlush">
    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, *" Padding="0,20,0,20">

            <Label Text="Våra katter"
                   HorizontalOptions="Center"  
                   VerticalOptions="Center"  
                   Style="{StaticResource Headline}"  
                   Grid.Row="0"></Label>

            <Label Text="Här är våra söta katter som söker ett nytt hem"  
                   HorizontalOptions="Center"
                   VerticalOptions="Center"  
                   FontSize="15"  
                   Grid.Row="1"></Label>

            <ListView ItemsSource="{Binding Cats}" ItemSelected="OnListViewItemSelected"  
            Grid.Row="2">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10"  
                                  RowDefinitions="*,*,*"  
                                  ColumnDefinitions="200, *"  
                                  ColumnSpacing="20">

                                <Image Grid.RowSpan="2"  
                                       Source="{Binding ImageUrl}"  
                                       HeightRequest="100"  
                                       WidthRequest="200"></Image>

                                <Label Grid.Column="1"  
                                       Text="{Binding Name}"  
                                       FontSize="20"></Label>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollView>
</ContentPage>